---
const categories = [
  {
    title: "Tools",
    description:
      "Tools and equipment I personally use or recommend for repairs, upgrades, diagnostics, and home-server projects.",
    link: "/tools",
    icon: "🔧",
  },
  {
    title: "Software",
    description:
      "Step-by-step projects for Jellyfin, Docker, Linux, Windows, networking, automation, and home servers.",
    link: "/software",
    icon: "💻",
  },
  {
    title: "Hardware",
    description:
      "Repair, upgrade, and troubleshooting guides for desktops, laptops, Steam Decks, storage, RAM, and more.",
    link: "/hardware",
    icon: "🖥️",
  },
];

const featuredGuides = [
  {
    title: "Set Up a Jellyfin Media Server",
    category: "Software",
    description:
      "Build a personal media server using Jellyfin, Docker, and Linux.",
  },
  {
    title: "Upgrade RAM in a Dell Precision 3630",
    category: "Hardware",
    description:
      "Find compatible RAM, install it safely, and verify the upgrade.",
  },
  {
    title: "Create a Bootable USB with Ventoy",
    category: "Software",
    description:
      "Store multiple operating-system and diagnostic images on one USB drive.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="BekTech offers practical technology tutorials, hardware guides, software projects, and personally recommended tools."
    />
    <title>BekTech | Practical Tech Guides</title>

    <style>
      :root {
        font-family:
          Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
        color: #e8edf5;
        background: #0a0f18;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at top, #17233a 0, transparent 38rem),
          #0a0f18;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      header {
        border-bottom: 1px solid #263247;
        background: rgba(10, 15, 24, 0.9);
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(12px);
      }

      nav {
        width: min(1120px, calc(100% - 32px));
        margin: auto;
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: -0.04em;
      }

      .logo span {
        color: #54a7ff;
      }

      .nav-links {
        display: flex;
        gap: 24px;
        color: #b8c2d1;
        font-weight: 600;
      }

      .nav-links a:hover {
        color: white;
      }

      main {
        width: min(1120px, calc(100% - 32px));
        margin: auto;
      }

      .hero {
        padding: 110px 0 80px;
        text-align: center;
      }

      .eyebrow {
        color: #7abaff;
        font-size: 0.85rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      h1 {
        margin: 14px auto 20px;
        max-width: 850px;
        font-size: clamp(2.7rem, 8vw, 5.5rem);
        line-height: 0.98;
        letter-spacing: -0.065em;
      }

      .hero-description {
        max-width: 710px;
        margin: auto;
        color: #acb7c7;
        font-size: 1.12rem;
        line-height: 1.7;
      }

      .search-form {
        max-width: 720px;
        margin: 38px auto 0;
        padding: 8px;
        display: flex;
        gap: 8px;
        border: 1px solid #33415a;
        border-radius: 16px;
        background: #111927;
        box-shadow: 0 18px 60px rgba(0, 0, 0, 0.3);
      }

      .search-form input {
        flex: 1;
        min-width: 0;
        border: 0;
        outline: 0;
        padding: 15px 16px;
        color: white;
        background: transparent;
        font: inherit;
      }

      .search-form button {
        border: 0;
        border-radius: 11px;
        padding: 0 24px;
        background: #368fe9;
        color: white;
        font: inherit;
        font-weight: 800;
        cursor: pointer;
      }

      section {
        padding: 42px 0 80px;
      }

      .section-heading {
        margin-bottom: 26px;
      }

      .section-heading h2 {
        margin: 0 0 8px;
        font-size: 2rem;
        letter-spacing: -0.04em;
      }

      .section-heading p {
        margin: 0;
        color: #9eaabd;
      }

      .category-grid,
      .guide-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }

      .card {
        border: 1px solid #27344a;
        border-radius: 18px;
        background: linear-gradient(145deg, #131d2d, #0e1521);
        transition:
          transform 160ms ease,
          border-color 160ms ease;
      }

      .card:hover {
        transform: translateY(-4px);
        border-color: #4d83bd;
      }

      .category-card {
        padding: 28px;
      }

      .category-icon {
        font-size: 2rem;
      }

      .card h3 {
        margin: 18px 0 10px;
        font-size: 1.3rem;
      }

      .card p {
        margin: 0;
        color: #aab5c5;
        line-height: 1.65;
      }

      .card-link {
        display: inline-block;
        margin-top: 22px;
        color: #70b5ff;
        font-weight: 800;
      }

      .guide-card {
        padding: 24px;
      }

      .guide-category {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 999px;
        color: #91c7ff;
        background: #172d47;
        font-size: 0.76rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      footer {
        border-top: 1px solid #263247;
        padding: 30px 16px;
        text-align: center;
        color: #8794a7;
      }

      @media (max-width: 800px) {
        .category-grid,
        .guide-grid {
          grid-template-columns: 1fr;
        }

        .nav-links {
          display: none;
        }

        .hero {
          padding-top: 80px;
        }
      }

      @media (max-width: 520px) {
        .search-form {
          flex-direction: column;
        }

        .search-form button {
          padding: 14px;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <nav>
        <a class="logo" href="/">Bek<span>Tech</span></a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/tools">Tools</a>
          <a href="/software">Software</a>
          <a href="/hardware">Hardware</a>
          <a href="/about">About</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="eyebrow">Practical technology made easier</div>

        <h1>Build it, repair it, and understand it.</h1>

        <p class="hero-description">
          Search practical guides for computer repairs, hardware upgrades,
          software projects, home servers, and tools I personally recommend.
        </p>

        <form class="search-form" action="/search">
          <input
            type="search"
            name="q"
            placeholder="Search Jellyfin, Dell 3630, Steam Deck..."
            aria-label="Search BekTech"
          />
          <button type="submit">Search</button>
        </form>
      </section>

      <section>
        <div class="section-heading">
          <h2>Explore BekTech</h2>
          <p>Choose a category to start finding guides and recommendations.</p>
        </div>

        <div class="category-grid">
          {
            categories.map((category) => (
              <a class="card category-card" href={category.link}>
                <div class="category-icon">{category.icon}</div>
                <h3>{category.title}</h3>
                <p>{category.description}</p>
                <span class="card-link">Explore {category.title} →</span>
              </a>
            ))
          }
        </div>
      </section>

      <section>
        <div class="section-heading">
          <h2>Featured guides</h2>
          <p>These placeholders will eventually become your real tutorials.</p>
        </div>

        <div class="guide-grid">
          {
            featuredGuides.map((guide) => (
              <article class="card guide-card">
                <span class="guide-category">{guide.category}</span>
                <h3>{guide.title}</h3>
                <p>{guide.description}</p>
                <a class="card-link" href="#">Read guide →</a>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <footer>
      <strong>BekTech</strong> — Practical guides based on real projects.
    </footer>
  </body>
</html>
