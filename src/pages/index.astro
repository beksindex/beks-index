---
const categories = [
  {
    title: "Tools",
    description:
      "Tools and equipment I personally use or recommend for repairs, upgrades, diagnostics, networking, and home-server projects.",
    link: "/tools",
    icon: "🔧",
  },
  {
    title: "Software",
    description:
      "Step-by-step guides for Linux, Windows, Docker, Jellyfin, networking, automation, troubleshooting, and home servers.",
    link: "/software",
    icon: "💻",
  },
  {
    title: "Hardware",
    description:
      "Repair, upgrade, and troubleshooting guides for desktops, laptops, storage, RAM, Steam Decks, and other technology.",
    link: "/hardware",
    icon: "🖥️",
  },
];

const featuredGuides = [
  {
    title: "Set Up a Jellyfin Media Server",
    category: "Software",
    description:
      "Build a personal media server using Jellyfin, Docker, and Linux.",
    link: "/software/jellyfin-media-server",
  },
  {
    title: "Upgrade RAM in a Dell Precision 3630",
    category: "Hardware",
    description:
      "Find compatible RAM, install it safely, and verify that the upgrade works.",
    link: "/hardware/dell-precision-3630-ram-upgrade",
  },
  {
    title: "Create a Bootable USB with Ventoy",
    category: "Software",
    description:
      "Store multiple operating systems and diagnostic tools on one USB drive.",
    link: "/software/create-ventoy-usb",
  },
];

const topics = [
  "Linux",
  "Docker",
  "Jellyfin",
  "PC repair",
  "Home servers",
  "Networking",
  "Windows",
  "Steam Deck",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="BEK's Index is a growing library of practical technology guides covering Linux, Docker, Jellyfin, computer repair, hardware upgrades, networking, home servers, and recommended tools."
    />

    <meta
      name="keywords"
      content="BEK's Index, Linux guides, Docker tutorials, Jellyfin, computer repair, PC hardware, home server, networking, technology guides"
    />

    <meta name="author" content="BEK" />

    <meta property="og:title" content="BEK's Index" />
    <meta
      property="og:description"
      content="Practical technology guides built from real projects and real troubleshooting."
    />
    <meta property="og:type" content="website" />

    <title>BEK's Index | Practical Technology Guides</title>

    <style>
      :root {
        font-family:
          Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;

        color: #e8edf5;
        background: #080d15;

        --background: #080d15;
        --background-soft: #0d1521;
        --surface: #111b2a;
        --surface-light: #162338;
        --border: #283750;
        --border-hover: #4c84c4;
        --text: #e8edf5;
        --text-muted: #a7b3c5;
        --text-dim: #7f8da2;
        --accent: #55aaff;
        --accent-light: #8bc6ff;
        --accent-dark: #247fda;
        --max-width: 1120px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        background:
          radial-gradient(
            circle at 50% -10%,
            rgba(41, 104, 177, 0.28),
            transparent 34rem
          ),
          radial-gradient(
            circle at 90% 30%,
            rgba(31, 81, 143, 0.12),
            transparent 30rem
          ),
          var(--background);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      input {
        font: inherit;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid rgba(40, 55, 80, 0.82);
        background: rgba(8, 13, 21, 0.88);
        backdrop-filter: blur(16px);
      }

      nav {
        width: min(var(--max-width), calc(100% - 32px));
        min-height: 74px;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
      }

      .logo {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 1.45rem;
        font-weight: 850;
        letter-spacing: -0.05em;
        white-space: nowrap;
      }

      .logo-mark {
        color: var(--text);
      }

      .logo-index {
        color: var(--accent);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 26px;
        color: #b8c3d3;
        font-size: 0.94rem;
        font-weight: 650;
      }

      .nav-links a {
        transition: color 150ms ease;
      }

      .nav-links a:hover {
        color: white;
      }

      .nav-button {
        padding: 10px 16px;
        border: 1px solid #396da6;
        border-radius: 10px;
        color: #ddecff;
        background: rgba(54, 143, 233, 0.12);
      }

      .nav-button:hover {
        color: white !important;
        background: rgba(54, 143, 233, 0.22);
      }

      main {
        width: min(var(--max-width), calc(100% - 32px));
        margin: auto;
      }

      .hero {
        padding: 118px 0 90px;
        text-align: center;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        color: var(--accent-light);
        font-size: 0.78rem;
        font-weight: 850;
        letter-spacing: 0.17em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 16px rgba(85, 170, 255, 0.85);
      }

      h1 {
        max-width: 900px;
        margin: 0 auto 24px;
        font-size: clamp(3.25rem, 8vw, 6.1rem);
        line-height: 0.94;
        letter-spacing: -0.075em;
      }

      .hero-accent {
        color: var(--accent);
      }

      .hero-description {
        max-width: 745px;
        margin: auto;
        color: var(--text-muted);
        font-size: clamp(1rem, 2vw, 1.16rem);
        line-height: 1.75;
      }

      .search-form {
        max-width: 760px;
        margin: 42px auto 0;
        padding: 8px;
        display: flex;
        gap: 8px;
        border: 1px solid #34445f;
        border-radius: 17px;
        background: rgba(17, 27, 42, 0.94);
        box-shadow:
          0 25px 80px rgba(0, 0, 0, 0.32),
          inset 0 1px rgba(255, 255, 255, 0.03);
      }

      .search-form:focus-within {
        border-color: #4c8dd3;
        box-shadow:
          0 25px 80px rgba(0, 0, 0, 0.32),
          0 0 0 3px rgba(54, 143, 233, 0.12);
      }

      .search-form input {
        flex: 1;
        min-width: 0;
        padding: 16px 17px;
        border: 0;
        outline: 0;
        color: white;
        background: transparent;
      }

      .search-form input::placeholder {
        color: #7f8ca0;
      }

      .search-form button {
        padding: 0 26px;
        border: 0;
        border-radius: 11px;
        color: white;
        background: linear-gradient(135deg, #409df5, #247ed7);
        font-weight: 800;
        cursor: pointer;
        transition:
          transform 150ms ease,
          filter 150ms ease;
      }

      .search-form button:hover {
        filter: brightness(1.08);
      }

      .search-form button:active {
        transform: scale(0.98);
      }

      .topic-list {
        max-width: 820px;
        margin: 24px auto 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 9px;
      }

      .topic {
        padding: 7px 11px;
        border: 1px solid #26364e;
        border-radius: 999px;
        color: #91a0b5;
        background: rgba(16, 25, 39, 0.72);
        font-size: 0.78rem;
      }

      section {
        padding: 50px 0 88px;
      }

      .section-heading {
        margin-bottom: 28px;
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 24px;
      }

      .section-heading h2 {
        margin: 0 0 9px;
        font-size: clamp(1.8rem, 4vw, 2.35rem);
        letter-spacing: -0.05em;
      }

      .section-heading p {
        max-width: 620px;
        margin: 0;
        color: var(--text-muted);
        line-height: 1.65;
      }

      .section-link {
        flex-shrink: 0;
        color: var(--accent-light);
        font-size: 0.92rem;
        font-weight: 750;
      }

      .section-link:hover {
        color: white;
      }

      .category-grid,
      .guide-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }

      .card {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 20px;
        background:
          linear-gradient(
            145deg,
            rgba(21, 33, 51, 0.96),
            rgba(12, 20, 31, 0.96)
          );
        box-shadow: 0 14px 45px rgba(0, 0, 0, 0.15);
        transition:
          transform 180ms ease,
          border-color 180ms ease,
          box-shadow 180ms ease;
      }

      .card::before {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(
          130deg,
          rgba(85, 170, 255, 0.07),
          transparent 45%
        );
        opacity: 0;
        transition: opacity 180ms ease;
      }

      .card:hover {
        transform: translateY(-5px);
        border-color: var(--border-hover);
        box-shadow: 0 22px 60px rgba(0, 0, 0, 0.27);
      }

      .card:hover::before {
        opacity: 1;
      }

      .category-card {
        min-height: 290px;
        padding: 30px;
        display: flex;
        flex-direction: column;
      }

      .category-icon {
        width: 54px;
        height: 54px;
        display: grid;
        place-items: center;
        border: 1px solid #314665;
        border-radius: 15px;
        background: rgba(62, 136, 216, 0.1);
        font-size: 1.7rem;
      }

      .card h3 {
        margin: 20px 0 11px;
        font-size: 1.32rem;
        letter-spacing: -0.025em;
      }

      .card p {
        margin: 0;
        color: var(--text-muted);
        line-height: 1.68;
      }

      .card-link {
        position: relative;
        z-index: 1;
        display: inline-block;
        margin-top: auto;
        padding-top: 23px;
        color: var(--accent-light);
        font-weight: 800;
      }

      .guide-card {
        min-height: 260px;
        padding: 26px;
        display: flex;
        flex-direction: column;
      }

      .guide-category {
        align-self: flex-start;
        display: inline-block;
        padding: 7px 11px;
        border: 1px solid rgba(74, 143, 215, 0.22);
        border-radius: 999px;
        color: #99ceff;
        background: rgba(34, 84, 135, 0.3);
        font-size: 0.72rem;
        font-weight: 850;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .mission {
        padding: 75px 0;
      }

      .mission-panel {
        padding: clamp(30px, 6vw, 58px);
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 46px;
        align-items: center;
        border: 1px solid #2e405b;
        border-radius: 24px;
        background:
          radial-gradient(
            circle at 80% 20%,
            rgba(51, 132, 220, 0.19),
            transparent 18rem
          ),
          linear-gradient(145deg, #111d2d, #0c141f);
      }

      .mission-label {
        margin-bottom: 13px;
        color: var(--accent-light);
        font-size: 0.78rem;
        font-weight: 850;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      .mission h2 {
        margin: 0 0 18px;
        font-size: clamp(2rem, 5vw, 3.25rem);
        line-height: 1.05;
        letter-spacing: -0.06em;
      }

      .mission p {
        margin: 0;
        color: var(--text-muted);
        line-height: 1.75;
      }

      .mission-points {
        display: grid;
        gap: 12px;
      }

      .mission-point {
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        border: 1px solid #2b3b53;
        border-radius: 13px;
        color: #c5d0df;
        background: rgba(8, 14, 23, 0.52);
        font-weight: 650;
      }

      .check {
        color: var(--accent);
        font-weight: 900;
      }

      footer {
        margin-top: 30px;
        border-top: 1px solid #25334a;
        color: var(--text-dim);
      }

      .footer-inner {
        width: min(var(--max-width), calc(100% - 32px));
        min-height: 110px;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .footer-brand {
        color: #aeb9c9;
      }

      .footer-brand strong {
        color: white;
      }

      .footer-links {
        display: flex;
        gap: 20px;
        font-size: 0.9rem;
      }

      .footer-links a:hover {
        color: white;
      }

      @media (max-width: 850px) {
        .category-grid,
        .guide-grid {
          grid-template-columns: 1fr;
        }

        .mission-panel {
          grid-template-columns: 1fr;
        }

        .nav-links {
          display: none;
        }

        .hero {
          padding-top: 88px;
        }

        .section-heading {
          align-items: start;
          flex-direction: column;
        }

        .category-card,
        .guide-card {
          min-height: auto;
        }
      }

      @media (max-width: 560px) {
        nav {
          min-height: 66px;
        }

        .hero {
          padding: 74px 0 62px;
        }

        h1 {
          font-size: clamp(3rem, 16vw, 4.4rem);
        }

        .search-form {
          flex-direction: column;
        }

        .search-form button {
          padding: 15px;
        }

        section {
          padding-bottom: 65px;
        }

        .footer-inner {
          padding: 28px 0;
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <nav aria-label="Main navigation">
        <a class="logo" href="/" aria-label="BEK's Index home">
          <span class="logo-mark">BEK's</span>
          <span class="logo-index">Index</span>
        </a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/tools">Tools</a>
          <a href="/software">Software</a>
          <a href="/hardware">Hardware</a>
          <a href="/about">About</a>
          <a class="nav-button" href="/guides">All Guides</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="eyebrow">Practical technology knowledge</div>

        <h1>
          Learn it. Build it.
          <span class="hero-accent">Fix it.</span>
        </h1>

        <p class="hero-description">
          BEK's Index is a growing library of practical technology guides built
          from real projects, real repairs, and real troubleshooting. Find
          clear instructions for Linux, Docker, home servers, hardware,
          networking, software, and the tools I actually use.
        </p>

        <form class="search-form" action="/search" method="get">
          <input
            type="search"
            name="q"
            placeholder="Search Linux, Jellyfin, Dell 3630, Ventoy..."
            aria-label="Search BEK's Index"
          />
          <button type="submit">Search the Index</button>
        </form>

        <div class="topic-list" aria-label="Popular topics">
          {
            topics.map((topic) => (
              <span class="topic">{topic}</span>
            ))
          }
        </div>
      </section>

      <section>
        <div class="section-heading">
          <div>
            <h2>Browse the Index</h2>
            <p>
              Explore practical tutorials, repair information, project guides,
              and recommendations organized by category.
            </p>
          </div>

          <a class="section-link" href="/guides">View all guides →</a>
        </div>

        <div class="category-grid">
          {
            categories.map((category) => (
              <a class="card category-card" href={category.link}>
                <div class="category-icon" aria-hidden="true">
                  {category.icon}
                </div>

                <h3>{category.title}</h3>
                <p>{category.description}</p>

                <span class="card-link">
                  Explore {category.title} →
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <section>
        <div class="section-heading">
          <div>
            <h2>Featured guides</h2>
            <p>
              A selection of practical tutorials and projects planned for
              BEK's Index.
            </p>
          </div>

          <a class="section-link" href="/guides">Browse everything →</a>
        </div>

        <div class="guide-grid">
          {
            featuredGuides.map((guide) => (
              <article class="card guide-card">
                <span class="guide-category">{guide.category}</span>
                <h3>{guide.title}</h3>
                <p>{guide.description}</p>
                <a class="card-link" href={guide.link}>
                  Read guide →
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section class="mission">
        <div class="mission-panel">
          <div>
            <div class="mission-label">What BEK's Index is about</div>

            <h2>Useful answers without the unnecessary nonsense.</h2>

            <p>
              I’m building BEK’s Index as a place where I can look
               back at the projects I’ve completed and remember exactly how I did them the first time.
               I’m also creating it so others can learn from my
                experience, avoid the mistakes I made, and build or 
                repair what they want without having to figure everything out blindly.

            </p>
          </div>

          <div class="mission-points">
            <div class="mission-point">
              <span class="check">✓</span>
              Tested through real projects
            </div>

            <div class="mission-point">
              <span class="check">✓</span>
              Written for normal people
            </div>

            <div class="mission-point">
              <span class="check">✓</span>
              Mistakes and fixes included
            </div>

            <div class="mission-point">
              <span class="check">✓</span>
              No filler added for search engines
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <strong>BEK's Index</strong><br />
          Practical technology knowledge built from real experience.
        </div>

        <div class="footer-links">
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a>
          <a href="https://github.com/beksindex">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>