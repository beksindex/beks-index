---
const pageTitle = "How to Create a Bootable USB with Ventoy";
const pageDescription =
  "Install Ventoy on a USB drive and use it to boot Windows, Linux, Hiren's BootCD, and other ISO files.";

const requirements = [
  "A USB drive with enough storage for your ISO files",
  "A Linux computer",
  "The latest Ventoy Linux download",
  "One or more bootable ISO files",
  "A computer you can use to test the USB",
];

const steps = [
  {
    number: "01",
    title: "Download Ventoy",
    description:
      "Download the Linux version of Ventoy from the official Ventoy website. The downloaded file will normally be a compressed .tar.gz archive.",
    image: "/images/ventoy/01-download-ventoy.jpg",
    alt: "Ventoy download page showing the Linux download option",
  },
  {
    number: "02",
    title: "Extract the Ventoy Download",
    description:
      "Open your Downloads folder, right-click the Ventoy archive, and extract it. This creates a new folder containing the Ventoy installation files.",
    image: "/images/ventoy/02-extract-ventoy.jpg",
    alt: "Ventoy archive being extracted in the Linux file manager",
  },
  {
    number: "03",
    title: "Insert and Identify the USB Drive",
    description:
      "Insert the USB drive and identify its device name before continuing. It may appear as something like /dev/sdb or /dev/sdc. Choosing the wrong drive can erase another storage device.",
    image: "/images/ventoy/03-identify-usb.jpg",
    alt: "Linux terminal showing the USB drive using the lsblk command",
  },
  {
    number: "04",
    title: "Install Ventoy on the USB",
    description:
      "Open a terminal inside the extracted Ventoy folder and run the Ventoy installation command using the correct USB device name. Confirm the warning when Ventoy asks permission to erase the drive.",
    image: "/images/ventoy/04-install-ventoy.jpg",
    alt: "Terminal showing Ventoy being installed on a USB drive",
  },
  {
    number: "05",
    title: "Copy ISO Files to the Ventoy Partition",
    description:
      "After installation, open the partition labeled Ventoy. Copy your ISO files directly onto it just like normal files. You do not need to extract or rewrite each ISO.",
    image: "/images/ventoy/05-copy-iso-files.jpg",
    alt: "Windows and Hiren's BootCD ISO files copied onto a Ventoy USB drive",
  },
  {
    number: "06",
    title: "Boot from the USB",
    description:
      "Insert the Ventoy USB into the computer you want to use. Open that computer's boot menu, select the USB drive, and choose the ISO you want from the Ventoy menu.",
    image: "/images/ventoy/06-ventoy-boot-menu.jpg",
    alt: "Ventoy boot menu displaying multiple ISO files",
  },
];

const problems = [
  {
    title: "The USB does not appear in the boot menu",
    answer:
      "Try another USB port, confirm USB boot is enabled in the BIOS or UEFI settings, and check whether the computer requires Legacy or UEFI boot mode.",
  },
  {
    title: "The ISO fails to boot",
    answer:
      "Make sure the ISO finished downloading and was copied completely. A damaged or incomplete ISO may appear in Ventoy but fail during startup.",
  },
  {
    title: "Secure Boot blocks the USB",
    answer:
      "Some computers may require Secure Boot to be disabled. Ventoy also supports Secure Boot on many systems, but setup behavior varies by motherboard.",
  },
  {
    title: "I copied the archive instead of the ISO",
    answer:
      "Ventoy needs the actual .iso file. Do not copy a .zip, .tar.gz, or other compressed download unless that file itself is the bootable image.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="description" content={pageDescription} />
    <meta name="author" content="BEK's Index" />

    <meta property="og:title" content={`${pageTitle} | BEK's Index`} />
    <meta property="og:description" content={pageDescription} />
    <meta
      property="og:image"
      content="/images/ventoy/ventoy-guide-cover.jpg"
    />
    <meta property="og:type" content="article" />

    <title>{pageTitle} | BEK's Index</title>

    <style>
      :root {
        color-scheme: dark;

        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;

        color: #edf3fb;
        background: #07101c;

        --background: #07101c;
        --surface: #0d1827;
        --surface-light: #122238;
        --border: #263952;
        --border-light: #355477;
        --text: #edf3fb;
        --muted: #a8b6c9;
        --blue: #55aaff;
        --blue-light: #9dd2ff;
        --warning: #ffc76b;
        --max-width: 1120px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(
            circle at 50% -10%,
            rgba(51, 132, 219, 0.24),
            transparent 34rem
          ),
          linear-gradient(180deg, #07101c, #080f19 55%, #07101c);
        color: var(--text);
      }

      img {
        display: block;
        max-width: 100%;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      input {
        font: inherit;
      }

      .container {
        width: min(var(--max-width), calc(100% - 32px));
        margin-inline: auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        border-bottom: 1px solid rgba(53, 84, 119, 0.55);
        background: rgba(7, 16, 28, 0.88);
        backdrop-filter: blur(18px);
      }

      .nav {
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        font-size: 1.45rem;
        font-weight: 900;
        letter-spacing: -0.055em;
      }

      .logo span {
        color: var(--blue);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 22px;
        color: var(--muted);
        font-size: 0.92rem;
        font-weight: 700;
      }

      .nav-links a:hover {
        color: var(--text);
      }

      .hero {
        padding: 92px 0 64px;
      }

      .breadcrumbs {
        margin-bottom: 30px;
        color: #8fa1b8;
        font-size: 0.88rem;
        font-weight: 650;
      }

      .breadcrumbs a:hover {
        color: var(--blue-light);
      }

      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
        gap: 54px;
        align-items: center;
      }

      .category {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border: 1px solid rgba(85, 170, 255, 0.32);
        border-radius: 999px;
        color: var(--blue-light);
        background: rgba(40, 105, 169, 0.18);
        font-size: 0.76rem;
        font-weight: 850;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      h1 {
        max-width: 820px;
        margin: 24px 0 22px;
        font-size: clamp(3rem, 7vw, 5.8rem);
        line-height: 0.98;
        letter-spacing: -0.07em;
      }

      .hero-description {
        max-width: 720px;
        margin: 0;
        color: var(--muted);
        font-size: clamp(1.05rem, 2vw, 1.22rem);
        line-height: 1.75;
      }

      .article-meta {
        margin-top: 28px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px 22px;
        color: #8fa1b8;
        font-size: 0.88rem;
        font-weight: 650;
      }

      .hero-image {
        min-height: 390px;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 26px;
        background:
          linear-gradient(
            135deg,
            rgba(85, 170, 255, 0.2),
            rgba(8, 16, 29, 0.05)
          ),
          var(--surface);
        box-shadow: 0 28px 75px rgba(0, 0, 0, 0.34);
      }

      .hero-image img {
        width: 100%;
        height: 100%;
        min-height: 390px;
        object-fit: cover;
      }

      .article-layout {
        display: grid;
        grid-template-columns: 250px minmax(0, 1fr);
        gap: 54px;
        align-items: start;
        padding-bottom: 100px;
      }

      .sidebar {
        position: sticky;
        top: 105px;
      }

      .sidebar-card {
        padding: 22px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: rgba(13, 24, 39, 0.88);
      }

      .sidebar h2 {
        margin: 0 0 16px;
        font-size: 0.78rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #90a5bd;
      }

      .table-of-contents {
        display: grid;
        gap: 12px;
      }

      .table-of-contents a {
        color: var(--muted);
        font-size: 0.91rem;
        line-height: 1.4;
      }

      .table-of-contents a:hover {
        color: var(--blue-light);
      }

      .article-content {
        min-width: 0;
      }

      .section {
        margin-bottom: 74px;
        scroll-margin-top: 105px;
      }

      .section-label {
        margin-bottom: 10px;
        color: var(--blue-light);
        font-size: 0.76rem;
        font-weight: 850;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      h2 {
        margin: 0 0 20px;
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.08;
        letter-spacing: -0.045em;
      }

      .section-intro {
        margin: 0 0 28px;
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.8;
      }

      .intro-card,
      .requirements-card,
      .warning,
      .note,
      .problem-card {
        border: 1px solid var(--border);
        border-radius: 20px;
        background: linear-gradient(145deg, var(--surface-light), var(--surface));
      }

      .intro-card {
        padding: 30px;
      }

      .intro-card p {
        margin: 0;
        color: #c6d1df;
        line-height: 1.9;
      }

      .intro-card p + p {
        margin-top: 20px;
      }

      .requirements-card {
        padding: 28px;
      }

      .requirements-list {
        margin: 0;
        padding: 0;
        display: grid;
        gap: 14px;
        list-style: none;
      }

      .requirements-list li {
        position: relative;
        padding-left: 32px;
        color: #c7d2df;
        line-height: 1.6;
      }

      .requirements-list li::before {
        content: "✓";
        position: absolute;
        left: 0;
        top: 0;
        color: var(--blue);
        font-weight: 900;
      }

      .warning {
        margin-top: 24px;
        padding: 22px;
        border-color: rgba(255, 199, 107, 0.42);
        background: rgba(116, 77, 21, 0.16);
      }

      .warning strong {
        display: block;
        margin-bottom: 8px;
        color: var(--warning);
      }

      .warning p {
        margin: 0;
        color: #dacdb8;
        line-height: 1.7;
      }

      .steps {
        display: grid;
        gap: 34px;
      }

      .step {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 24px;
        background: linear-gradient(145deg, #102036, #0b1625);
      }

      .step-content {
        padding: 30px;
      }

      .step-number {
        margin-bottom: 14px;
        color: var(--blue);
        font-size: 0.8rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .step h3 {
        margin: 0 0 12px;
        font-size: clamp(1.45rem, 3vw, 2rem);
        letter-spacing: -0.035em;
      }

      .step p {
        margin: 0;
        color: var(--muted);
        line-height: 1.8;
      }

      .step-image {
        min-height: 330px;
        border-top: 1px solid var(--border);
        background:
          linear-gradient(
            135deg,
            rgba(85, 170, 255, 0.12),
            transparent
          ),
          #0a1421;
      }

      .step-image img {
        width: 100%;
        height: 100%;
        min-height: 330px;
        object-fit: cover;
      }

      .image-placeholder {
        min-height: 330px;
        display: grid;
        place-items: center;
        padding: 30px;
        color: #71839a;
        text-align: center;
      }

      .note {
        padding: 24px;
      }

      .note strong {
        display: block;
        margin-bottom: 8px;
        color: var(--blue-light);
      }

      .note p {
        margin: 0;
        color: #c0ccda;
        line-height: 1.75;
      }

      .command {
        margin: 18px 0;
        overflow-x: auto;
        padding: 18px 20px;
        border: 1px solid #2c4461;
        border-radius: 13px;
        color: #d8edff;
        background: #050b13;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: 0.92rem;
        line-height: 1.6;
      }

      .problems {
        display: grid;
        gap: 16px;
      }

      .problem-card {
        padding: 24px;
      }

      .problem-card h3 {
        margin: 0 0 10px;
        font-size: 1.05rem;
      }

      .problem-card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
      }

      .complete-card {
        padding: 34px;
        border: 1px solid rgba(85, 170, 255, 0.38);
        border-radius: 24px;
        background:
          radial-gradient(
            circle at 100% 0%,
            rgba(85, 170, 255, 0.18),
            transparent 22rem
          ),
          linear-gradient(145deg, #102238, #0b1726);
      }

      .complete-card h2 {
        margin-bottom: 14px;
      }

      .complete-card p {
        margin: 0;
        color: #c0ccda;
        line-height: 1.8;
      }

      .related-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
      }

      .related-card {
        padding: 25px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--surface);
        transition:
          transform 160ms ease,
          border-color 160ms ease;
      }

      .related-card:hover {
        transform: translateY(-3px);
        border-color: var(--border-light);
      }

      .related-card span {
        color: var(--blue-light);
        font-size: 0.75rem;
        font-weight: 850;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .related-card h3 {
        margin: 10px 0 8px;
      }

      .related-card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.65;
      }

      .site-footer {
        border-top: 1px solid var(--border);
        padding: 44px 0;
        color: #8494aa;
      }

      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .footer-brand {
        color: var(--text);
        font-weight: 850;
      }

      @media (max-width: 900px) {
        .hero-grid {
          grid-template-columns: 1fr;
        }

        .article-layout {
          grid-template-columns: 1fr;
        }

        .sidebar {
          position: static;
        }

        .table-of-contents {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 650px) {
        .hero {
          padding-top: 62px;
        }

        .nav-links {
          display: none;
        }

        .hero-image,
        .hero-image img {
          min-height: 260px;
        }

        .table-of-contents {
          grid-template-columns: 1fr;
        }

        .related-grid {
          grid-template-columns: 1fr;
        }

        .step-content,
        .intro-card,
        .requirements-card,
        .complete-card {
          padding: 22px;
        }

        .step-image,
        .step-image img,
        .image-placeholder {
          min-height: 240px;
        }

        .footer-inner {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <nav class="nav container">
        <a class="logo" href="/">
          BEK's <span>Index</span>
        </a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/search">Search</a>
          <a href="#steps">Steps</a>
          <a href="#problems">Common Problems</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <div class="breadcrumbs">
            <a href="/">Home</a>
            <span> / </span>
            <a href="/search?q=software">Software</a>
            <span> / </span>
            <span>Ventoy USB</span>
          </div>

          <div class="hero-grid">
            <div>
              <span class="category">Software Guide</span>

              <h1>{pageTitle}</h1>

              <p class="hero-description">
                Turn one USB drive into a reusable bootable toolkit that can
                hold Windows installers, Linux distributions, Hiren's BootCD,
                and other ISO files.
              </p>

              <div class="article-meta">
                <span>Updated July 2026</span>
                <span>About 8 minutes</span>
                <span>Beginner friendly</span>
              </div>
            </div>

            <div class="hero-image">
              <img
                src="/images/ventoy/ventoy-guide-cover.jpg"
                alt="USB drive prepared with Ventoy and multiple bootable ISO files"
              />
            </div>
          </div>
        </div>
      </section>

      <div class="article-layout container">
        <aside class="sidebar">
          <div class="sidebar-card">
            <h2>On this page</h2>

            <nav class="table-of-contents">
              <a href="#overview">What Ventoy does</a>
              <a href="#requirements">What you need</a>
              <a href="#steps">Installation steps</a>
              <a href="#commands">Useful commands</a>
              <a href="#problems">Common problems</a>
              <a href="#finished">Finished result</a>
            </nav>
          </div>
        </aside>

        <article class="article-content">
          <section class="section" id="overview">
            <div class="section-label">Overview</div>
            <h2>What Ventoy does</h2>

            <div class="intro-card">
              <p>
                Ventoy changes the way a bootable USB drive works. Normally,
                creating a Windows or Linux installation drive completely
                rewrites the USB for one operating system.
              </p>

              <p>
                With Ventoy, you install the Ventoy system once. After that,
                you can drag normal ISO files onto the USB. When you boot from
                it, Ventoy displays a menu and lets you choose which ISO to
                start.
              </p>

              <p>
                I use this setup because it lets me keep Windows installers,
                Linux systems, and computer diagnostic tools together on one
                thumb drive.
              </p>
            </div>
          </section>

          <section class="section" id="requirements">
            <div class="section-label">Preparation</div>
            <h2>What you need</h2>

            <div class="requirements-card">
              <ul class="requirements-list">
                {
                  requirements.map((item) => (
                    <li>{item}</li>
                  ))
                }
              </ul>
            </div>

            <div class="warning">
              <strong>Warning: Ventoy erases the USB drive.</strong>
              <p>
                Move anything important off the USB before installing Ventoy.
                Also verify the device name carefully so you do not erase the
                wrong storage drive.
              </p>
            </div>
          </section>

          <section class="section" id="steps">
            <div class="section-label">Step-by-step</div>
            <h2>Install Ventoy and add your ISO files</h2>

            <p class="section-intro">
              These steps document the Linux process. The exact buttons and
              device names may look slightly different on your computer.
            </p>

            <div class="steps">
              {
                steps.map((step) => (
                  <section class="step">
                    <div class="step-content">
                      <div class="step-number">Step {step.number}</div>
                      <h3>{step.title}</h3>
                      <p>{step.description}</p>
                    </div>

                    <div class="step-image">
                      <img
                        src={step.image}
                        alt={step.alt}
                        loading="lazy"
                      />
                    </div>
                  </section>
                ))
              }
            </div>
          </section>

          <section class="section" id="commands">
            <div class="section-label">Linux commands</div>
            <h2>Commands used in this guide</h2>

            <p class="section-intro">
              Use these commands only after confirming the location of the
              extracted Ventoy folder and the correct USB device.
            </p>

            <div class="note">
              <strong>Identify connected drives</strong>
              <p>
                This lists your storage devices and helps you identify the USB
                drive by its size.
              </p>

              <pre class="command"><code>lsblk -o NAME,SIZE,MODEL,MOUNTPOINTS</code></pre>
            </div>

            <div class="note" style="margin-top: 18px;">
              <strong>Open the extracted Ventoy folder</strong>
              <p>
                Change this path to match the version of Ventoy you downloaded.
              </p>

              <pre class="command"><code>cd ~/Downloads/ventoy-1.1.17</code></pre>
            </div>

            <div class="note" style="margin-top: 18px;">
              <strong>Install Ventoy</strong>
              <p>
                Replace <code>/dev/sdX</code> with the actual USB device. Do not
                add a partition number such as <code>1</code>.
              </p>

              <pre class="command"><code>sudo ./Ventoy2Disk.sh -i /dev/sdX</code></pre>
            </div>

            <div class="note" style="margin-top: 18px;">
              <strong>Copy ISO files</strong>
              <p>
                You can also copy them through the normal file manager. These
                commands are examples using the terminal.
              </p>

              <pre class="command"><code>cp ~/Downloads/HBCD_PE_x64.iso /run/media/$USER/Ventoy/
cp ~/Downloads/Win11_25H2_English_x64_v2.iso /run/media/$USER/Ventoy/</code></pre>
            </div>
          </section>

          <section class="section" id="problems">
            <div class="section-label">Troubleshooting</div>
            <h2>Common problems</h2>

            <div class="problems">
              {
                problems.map((problem) => (
                  <div class="problem-card">
                    <h3>{problem.title}</h3>
                    <p>{problem.answer}</p>
                  </div>
                ))
              }
            </div>
          </section>

          <section class="section" id="finished">
            <div class="complete-card">
              <div class="section-label">Finished</div>
              <h2>Your reusable bootable USB is ready</h2>

              <p>
                Once Ventoy is working, adding another tool is usually as easy
                as downloading its ISO and copying that file onto the Ventoy
                partition. You can remove old ISO files the same way without
                reinstalling Ventoy.
              </p>
            </div>
          </section>

          <section class="section">
            <div class="section-label">Keep learning</div>
            <h2>Related guides</h2>

            <div class="related-grid">
              <a class="related-card" href="#">
                <span>Diagnostics</span>
                <h3>How to Use Hiren's BootCD</h3>
                <p>
                  Boot into Hiren's and use its tools to test a computer before
                  repairing or selling it.
                </p>
              </a>

              <a class="related-card" href="#">
                <span>Windows</span>
                <h3>Install Windows 11 Without a Microsoft Account</h3>
                <p>
                  Complete Windows setup using a local account instead of
                  connecting an online Microsoft account.
                </p>
              </a>
            </div>
          </section>
        </article>
      </div>
    </main>

    <footer class="site-footer">
      <div class="footer-inner container">
