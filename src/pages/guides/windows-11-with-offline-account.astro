---
const pageTitle = "How to Install Windows 11 With an Offline Account";

const pageDescription =
  "Perform a clean Windows 11 installation and create a local offline user profile without signing in with a Microsoft account.";

const requirements = [
  "A computer that supports Windows 11",
  "A bootable Windows 11 USB or Ventoy USB",
  "The official Windows 11 ISO",
  "A backup of any important files",
  "The Windows license or motherboard activation key, if available",
  "A keyboard connected directly to the computer",
];

const installationSteps = [
  {
    number: "01",
    title: "Download the Windows 11 ISO",
    description:
      "Download the current Windows 11 disk image directly from Microsoft. Select the correct language, then download the 64-bit ISO file.",
    image: "/images/windows-11/01-download-windows-11.jpg",
    alt: "Official Microsoft Windows 11 ISO download page",
  },
  {
    number: "02",
    title: "Copy the ISO to Your Ventoy USB",
    description:
      "Open the Ventoy partition and copy the complete Windows 11 ISO onto it. Do not extract the ISO. Ventoy can boot the file directly.",
    image: "/images/windows-11/02-copy-iso-to-ventoy.jpg",
    alt: "Windows 11 ISO copied onto a Ventoy USB drive",
  },
  {
    number: "03",
    title: "Open the Computer's Boot Menu",
    description:
      "Insert the USB into the computer and turn it on. Repeatedly press the boot-menu key until the device menu appears. Common keys include F12, F11, F9, Escape, and Delete.",
    image: "/images/windows-11/03-open-boot-menu.jpg",
    alt: "Computer boot menu showing a Ventoy USB drive",
  },
  {
    number: "04",
    title: "Select the Windows 11 ISO",
    description:
      "Choose the Ventoy USB from the computer's boot menu. When Ventoy loads, highlight the Windows 11 ISO and press Enter.",
    image: "/images/windows-11/04-select-windows-iso.jpg",
    alt: "Ventoy menu with the Windows 11 ISO selected",
  },
  {
    number: "05",
    title: "Start Windows Setup",
    description:
      "Select your installation language, time format, and keyboard layout. Choose Install now to begin the Windows installation.",
    image: "/images/windows-11/05-windows-setup.jpg",
    alt: "Windows 11 installation language and keyboard selection screen",
  },
  {
    number: "06",
    title: "Handle the Product-Key Screen",
    description:
      "Enter a Windows product key when you have one. If the computer already has a digital license or an activation key stored in its motherboard, select I don't have a product key and continue.",
    image: "/images/windows-11/06-product-key.jpg",
    alt: "Windows Setup product-key entry screen",
  },
  {
    number: "07",
    title: "Choose the Correct Windows Edition",
    description:
      "Select the edition that matches the computer's license, such as Windows 11 Home or Windows 11 Pro. Choosing the wrong edition can prevent automatic activation.",
    image: "/images/windows-11/07-select-edition.jpg",
    alt: "Windows Setup edition-selection screen",
  },
  {
    number: "08",
    title: "Choose a Custom Installation",
    description:
      "Accept the license terms and select Custom: Install Windows only. This option is used for a clean installation rather than upgrading an existing copy of Windows.",
    image: "/images/windows-11/08-custom-installation.jpg",
    alt: "Windows Setup custom installation option",
  },
  {
    number: "09",
    title: "Select the Installation Drive",
    description:
      "Identify the SSD or hard drive where Windows will be installed. For a completely clean installation, delete the old Windows partitions on that drive until it appears as unallocated space, then select it and continue.",
    image: "/images/windows-11/09-select-drive.jpg",
    alt: "Windows Setup drive and partition selection screen",
  },
  {
    number: "10",
    title: "Allow Windows to Install",
    description:
      "Windows will copy files, install features, and restart the computer several times. Do not turn the computer off. After the first restart, avoid booting into the USB installer again.",
    image: "/images/windows-11/10-installing-windows.jpg",
    alt: "Windows 11 installation progress screen",
  },
];

const offlineSteps = [
  {
    number: "11",
    title: "Begin the Windows 11 First-Time Setup",
    description:
      "Select the correct country and keyboard layout. Skip the second keyboard layout unless you actually use one.",
    image: "/images/windows-11/11-region-keyboard.jpg",
    alt: "Windows 11 country and keyboard setup screen",
  },
  {
    number: "12",
    title: "Stop at the Internet Requirement",
    description:
      "Continue until Windows asks you to connect to a network. Do not connect to Wi-Fi or Ethernet if you want to create the local profile during setup.",
    image: "/images/windows-11/12-network-screen.jpg",
    alt: "Windows 11 setup screen requiring an internet connection",
  },
  {
    number: "13",
    title: "Open Command Prompt",
    description:
      "Press Shift and F10 together while on the network screen. On some laptops, you may need to press Shift, Fn, and F10. A Command Prompt window should appear.",
    image: "/images/windows-11/13-open-command-prompt.jpg",
    alt: "Command Prompt opened during Windows 11 first-time setup",
  },
  {
    number: "14",
    title: "Run the Offline-Setup Command",
    description:
      "Enter the command shown below and press Enter. The computer should restart automatically and return to the Windows setup process.",
    image: "/images/windows-11/14-bypass-command.jpg",
    alt: "OOBE bypass command entered in Windows Command Prompt",
  },
  {
    number: "15",
    title: "Choose the Offline Setup Option",
    description:
      "Return through the country and keyboard screens. At the network screen, select I don't have internet, then choose Continue with limited setup.",
    image: "/images/windows-11/15-no-internet-option.jpg",
    alt: "Windows 11 I don't have internet option",
  },
  {
    number: "16",
    title: "Create the Local User Profile",
    description:
      "Enter the name you want for the local account. Add a password when needed, or leave it blank when you intentionally want the computer to sign in without one.",
    image: "/images/windows-11/16-create-local-account.jpg",
    alt: "Windows 11 local user account creation screen",
  },
  {
    number: "17",
    title: "Review the Privacy Settings",
    description:
      "Review each privacy option instead of accepting everything automatically. Disable any location, advertising, diagnostic, or personalized-experience options you do not want.",
    image: "/images/windows-11/17-privacy-settings.jpg",
    alt: "Windows 11 privacy settings displayed during setup",
  },
  {
    number: "18",
    title: "Reach the Windows Desktop",
    description:
      "Windows will finish preparing the profile and load the desktop. The computer is now running Windows 11 with a local offline account.",
    image: "/images/windows-11/18-windows-desktop.jpg",
    alt: "Freshly installed Windows 11 desktop",
  },
];

const afterInstallation = [
  {
    title: "Connect to the internet",
    text: "Reconnect Ethernet or join the correct Wi-Fi network after reaching the desktop.",
  },
  {
    title: "Run Windows Update",
    text: "Open Settings, select Windows Update, and install available security updates and drivers. Restart and check again until no important updates remain.",
  },
  {
    title: "Check activation",
    text: "Open Settings, System, and Activation. Verify that Windows reports an active digital license.",
  },
  {
    title: "Check Device Manager",
    text: "Look for devices displaying warning symbols. These usually indicate missing or incorrect drivers.",
  },
  {
    title: "Install manufacturer drivers",
    text: "Install chipset, graphics, networking, and firmware updates from the computer or motherboard manufacturer when Windows Update does not provide them.",
  },
  {
    title: "Remove the installation USB",
    text: "Eject the Ventoy USB after the installation is complete so the computer does not accidentally boot back into Windows Setup.",
  },
];

const problems = [
  {
    title: "Shift + F10 does not open Command Prompt",
    answer:
      "Try Shift + Fn + F10, especially on laptops where the function keys control brightness or volume. A wired external keyboard can also help.",
  },
  {
    title: "The computer boots back into Windows Setup",
    answer:
      "Remove the USB after Windows has copied its files, or select Windows Boot Manager instead of the USB in the boot menu.",
  },
  {
    title: "The SSD does not appear",
    answer:
      "The computer may require a storage-controller driver, or its BIOS storage mode may be set to RAID or Intel VMD. Do not randomly change this setting on a system containing important data.",
  },
  {
    title: "Windows does not activate",
    answer:
      "Confirm that you installed the same edition previously licensed for the computer. A Windows Home license normally will not activate Windows Pro.",
  },
  {
    title: "The offline command is not recognized",
    answer:
      "Microsoft can change the Windows first-time setup process. Verify that the command was entered exactly and that the backslash was used. A future Windows build may require a revised method.",
  },
  {
    title: "There is no Wi-Fi after installation",
    answer:
      "Windows may not include the correct network driver. Download the driver on another computer and transfer it using a USB drive.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="description" content={pageDescription} />
    <meta name="author" content="BEK's Index" />

    <meta property="og:title" content={`${pageTitle} | BEK's Index`} />
    <meta property="og:description" content={pageDescription} />
    <meta
      property="og:image"
      content="/images/windows-11/windows-11-guide-cover.jpg"
    />
    <meta property="og:type" content="article" />

    <title>{pageTitle} | BEK's Index</title>

    <style>
      :root {
        color-scheme: dark;

        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;

        --background: #07101c;
        --surface: #0d1827;
        --surface-light: #122238;
        --border: #263952;
        --border-light: #355477;
        --text: #edf3fb;
        --muted: #a8b6c9;
        --blue: #55aaff;
        --blue-light: #9dd2ff;
        --warning: #ffc76b;
        --danger: #ff9d9d;
        --max-width: 1120px;

        color: var(--text);
        background: var(--background);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(
            circle at 50% -10%,
            rgba(51, 132, 219, 0.24),
            transparent 34rem
          ),
          linear-gradient(180deg, #07101c, #080f19 55%, #07101c);
      }

      img {
        display: block;
        max-width: 100%;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      code {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
      }

      .container {
        width: min(var(--max-width), calc(100% - 32px));
        margin-inline: auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        border-bottom: 1px solid rgba(53, 84, 119, 0.55);
        background: rgba(7, 16, 28, 0.88);
        backdrop-filter: blur(18px);
      }

      .nav {
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .logo {
        font-size: 1.45rem;
        font-weight: 900;
        letter-spacing: -0.055em;
      }

      .logo span {
        color: var(--blue);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 22px;
        color: var(--muted);
        font-size: 0.92rem;
        font-weight: 700;
      }

      .nav-links a:hover {
        color: var(--text);
      }

      .hero {
        padding: 92px 0 64px;
      }

      .breadcrumbs {
        margin-bottom: 30px;
        color: #8fa1b8;
        font-size: 0.88rem;
        font-weight: 650;
      }

      .breadcrumbs a:hover {
        color: var(--blue-light);
      }

      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
        gap: 54px;
        align-items: center;
      }

      .category {
        display: inline-flex;
        padding: 8px 12px;
        border: 1px solid rgba(85, 170, 255, 0.32);
        border-radius: 999px;
        color: var(--blue-light);
        background: rgba(40, 105, 169, 0.18);
        font-size: 0.76rem;
        font-weight: 850;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      h1 {
        margin: 24px 0 22px;
        font-size: clamp(3rem, 7vw, 5.5rem);
        line-height: 0.98;
        letter-spacing: -0.07em;
      }

      .hero-description {
        margin: 0;
        color: var(--muted);
        font-size: clamp(1.05rem, 2vw, 1.22rem);
        line-height: 1.75;
      }

      .article-meta {
        margin-top: 28px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px 22px;
        color: #8fa1b8;
        font-size: 0.88rem;
        font-weight: 650;
      }

      .hero-image {
        min-height: 390px;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 26px;
        background:
          linear-gradient(
            135deg,
            rgba(85, 170, 255, 0.2),
            rgba(8, 16, 29, 0.05)
          ),
          var(--surface);
        box-shadow: 0 28px 75px rgba(0, 0, 0, 0.34);
      }

      .hero-image img {
        width: 100%;
        height: 100%;
        min-height: 390px;
        object-fit: cover;
      }

      .article-layout {
        display: grid;
        grid-template-columns: 250px minmax(0, 1fr);
        gap: 54px;
        align-items: start;
        padding-bottom: 100px;
      }

      .sidebar {
        position: sticky;
        top: 105px;
      }

      .sidebar-card {
        padding: 22px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: rgba(13, 24, 39, 0.88);
      }

      .sidebar h2 {
        margin: 0 0 16px;
        color: #90a5bd;
        font-size: 0.78rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .table-of-contents {
        display: grid;
        gap: 12px;
      }

      .table-of-contents a {
        color: var(--muted);
        font-size: 0.91rem;
        line-height: 1.4;
      }

      .table-of-contents a:hover {
        color: var(--blue-light);
      }

      .article-content {
        min-width: 0;
      }

      .section {
        margin-bottom: 74px;
        scroll-margin-top: 105px;
      }

      .section-label {
        margin-bottom: 10px;
        color: var(--blue-light);
        font-size: 0.76rem;
        font-weight: 850;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      h2 {
        margin: 0 0 20px;
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.08;
        letter-spacing: -0.045em;
      }

      .section-intro {
        margin: 0 0 28px;
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.8;
      }

      .card,
      .requirements-card,
      .warning,
      .critical-warning,
      .note,
      .problem-card,
      .check-card {
        border: 1px solid var(--border);
        border-radius: 20px;
        background: linear-gradient(145deg, var(--surface-light), var(--surface));
      }

      .card,
      .requirements-card {
        padding: 28px;
      }

      .card p {
        margin: 0;
        color: #c6d1df;
        line-height: 1.9;
      }

      .card p + p {
        margin-top: 20px;
      }

      .requirements-list {
        margin: 0;
        padding: 0;
        display: grid;
        gap: 14px;
        list-style: none;
      }

      .requirements-list li {
        position: relative;
        padding-left: 32px;
        color: #c7d2df;
        line-height: 1.6;
      }

      .requirements-list li::before {
        content: "✓";
        position: absolute;
        left: 0;
        color: var(--blue);
        font-weight: 900;
      }

      .warning,
      .critical-warning {
        margin-top: 24px;
        padding: 22px;
      }

      .warning {
        border-color: rgba(255, 199, 107, 0.42);
        background: rgba(116, 77, 21, 0.16);
      }

      .critical-warning {
        border-color: rgba(255, 125, 125, 0.45);
        background: rgba(111, 28, 28, 0.18);
      }

      .warning strong {
        color: var(--warning);
      }

      .critical-warning strong {
        color: var(--danger);
      }

      .warning strong,
      .critical-warning strong {
        display: block;
        margin-bottom: 8px;
      }

      .warning p,
      .critical-warning p {
        margin: 0;
        color: #d7cdbf;
        line-height: 1.7;
      }

      .steps {
        display: grid;
        gap: 34px;
      }

      .step {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 24px;
        background: linear-gradient(145deg, #102036, #0b1625);
      }

      .step-content {
        padding: 30px;
      }

      .step-number {
        margin-bottom: 14px;
        color: var(--blue);
        font-size: 0.8rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .step h3 {
        margin: 0 0 12px;
        font-size: clamp(1.45rem, 3vw, 2rem);
        letter-spacing: -0.035em;
      }

      .step p {
        margin: 0;
        color: var(--muted);
        line-height: 1.8;
      }

      .step-image {
        min-height: 330px;
        border-top: 1px solid var(--border);
        background: #0a1421;
      }

      .step-image img {
        width: 100%;
        min-height: 330px;
        height: 100%;
        object-fit: cover;
      }

      .command-box {
        margin-top: 22px;
        padding: 26px;
        border: 1px solid rgba(85, 170, 255, 0.42);
        border-radius: 20px;
        background:
          radial-gradient(
            circle at 100% 0%,
            rgba(85, 170, 255, 0.15),
            transparent 20rem
          ),
          #091421;
      }

      .command-box strong {
        display: block;
        margin-bottom: 12px;
        color: var(--blue-light);
      }

      .command {
        margin: 0;
        overflow-x: auto;
        padding: 18px 20px;
        border: 1px solid #2c4461;
        border-radius: 13px;
        color: #d8edff;
        background: #050b13;
        font-size: 1rem;
        line-height: 1.6;
      }

      .command-explanation {
        margin: 16px 0 0;
        color: var(--muted);
        line-height: 1.7;
      }

      .checklist,
      .problems {
        display: grid;
        gap: 16px;
      }

      .check-card,
      .problem-card {
        padding: 24px;
      }

      .check-card h3,
      .problem-card h3 {
        margin: 0 0 10px;
        font-size: 1.05rem;
      }

      .check-card p,
      .problem-card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
      }

      .complete-card {
        padding: 34px;
        border: 1px solid rgba(85, 170, 255, 0.38);
        border-radius: 24px;
        background:
          radial-gradient(
            circle at 100% 0%,
            rgba(85, 170, 255, 0.18),
            transparent 22rem
          ),
          linear-gradient(145deg, #102238, #0b1726);
      }

      .complete-card p {
        margin: 0;
        color: #c0ccda;
        line-height: 1.8;
      }

      .related-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
      }

      .related-card {
        padding: 25px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--surface);
        transition:
          transform 160ms ease,
          border-color 160ms ease;
      }

      .related-card:hover {
        transform: translateY(-3px);
        border-color: var(--border-light);
      }

      .related-card span {
        color: var(--blue-light);
        font-size: 0.75rem;
        font-weight: 850;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .related-card h3 {
        margin: 10px 0 8px;
      }

      .related-card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.65;
      }

      .site-footer {
        border-top: 1px solid var(--border);
        padding: 44px 0;
        color: #8494aa;
      }

      .footer-inner {
        display: flex;
        justify-content: space-between;
        gap: 24px;
      }

      .footer-brand {
        color: var(--text);
        font-weight: 850;
      }

      @media (max-width: 900px) {
        .hero-grid,
        .article-layout {
          grid-template-columns: 1fr;
        }

        .sidebar {
          position: static;
        }

        .table-of-contents {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 650px) {
        .hero {
          padding-top: 62px;
        }

        .nav-links {
          display: none;
        }

        .hero-image,
        .hero-image img {
          min-height: 260px;
        }

        .table-of-contents,
        .related-grid {
          grid-template-columns: 1fr;
        }

        .step-content,
        .card,
        .requirements-card,
        .complete-card {
          padding: 22px;
        }

        .step-image,
        .step-image img {
          min-height: 240px;
        }

        .footer-inner {
          flex-direction: column;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <nav class="nav container">
        <a class="logo" href="/">
          BEK's <span>Index</span>
        </a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/search">Search</a>
          <a href="#installation">Installation</a>
          <a href="#offline-account">Offline Account</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <div class="breadcrumbs">
            <a href="/">Home</a>
            <span> / </span>
            <span>Windows</span>
            <span> / </span>
            <span>Install Windows 11</span>
          </div>

          <div class="hero-grid">
            <div>
              <span class="category">Windows Guide</span>

              <h1>{pageTitle}</h1>

              <p class="hero-description">
                Perform a clean Windows 11 installation, avoid being forced
                into an online Microsoft profile, and finish setup using a
                normal local user account.
              </p>

              <div class="article-meta">
                <span>Updated July 2026</span>
                <span>About 15 minutes to read</span>
                <span>Beginner friendly</span>
              </div>
            </div>

            <div class="hero-image">
              <img
                src="/images/windows-11/windows-11-guide-cover.jpg"
                alt="Windows 11 installation screen and bootable USB drive"
              />
            </div>
          </div>
        </div>
      </section>

      <div class="article-layout container">
        <aside class="sidebar">
          <div class="sidebar-card">
            <h2>On this page</h2>

            <nav class="table-of-contents">
              <a href="#overview">Overview</a>
              <a href="#requirements">What you need</a>
              <a href="#installation">Install Windows</a>
              <a href="#offline-account">Create offline profile</a>
              <a href="#after-installation">After installation</a>
              <a href="#problems">Common problems</a>
              <a href="#finished">Finished result</a>
            </nav>
          </div>
        </aside>

        <article class="article-content">
          <section class="section" id="overview">
            <div class="section-label">Overview</div>
            <h2>What this guide covers</h2>

            <div class="card">
              <p>
                This guide covers a complete clean installation of Windows 11
                using an ISO stored on a Ventoy USB drive.
              </p>

              <p>
                It also documents how I bypassed the required internet and
                Microsoft-account screen so I could create a normal local
                profile instead.
              </p>

              <p>
                I prefer this setup when repairing or preparing computers
                because the machine is not automatically connected to somebody
                else's Microsoft account during installation.
              </p>
            </div>
            <div class="note" style="margin-top: 24px; padding: 24px;">
  <strong>💡 Need a bootable USB first?</strong>

  <p style="margin-top: 12px;">
    This guide assumes you already have a bootable Ventoy USB drive.
    If you don't have one yet, follow this guide first:
  </p>

  <p style="margin-top: 18px;">
    <a
      href="/guides/create-bootable-usb-with-ventoy"
      style="color: var(--blue-light); font-weight:700;"
    >
      👉 How to Create a Bootable USB with Ventoy
    </a>
  </p>
</div>
          </section>

          <section class="section" id="requirements">
            <div class="section-label">Preparation</div>
            <h2>What you need</h2>

            <div class="requirements-card">
              <ul class="requirements-list">
                {requirements.map((item) => <li>{item}</li>)}
              </ul>
            </div>

            <div class="critical-warning">
              <strong>Warning: A clean installation can erase the drive.</strong>
              <p>
                Back up important files before continuing. Deleting Windows
                partitions removes the existing operating system, programs,
                accounts, and personal files stored on those partitions.
              </p>
            </div>
          </section>

          <section class="section" id="installation">
            <div class="section-label">Part one</div>
            <h2>Install Windows 11</h2>

            <p class="section-intro">
              Follow these steps until Windows finishes copying its files and
              begins the first-time setup.
            </p>

            <div class="steps">
              {installationSteps.map((step) => (
                <section class="step">
                  <div class="step-content">
                    <div class="step-number">Step {step.number}</div>
                    <h3>{step.title}</h3>
                    <p>{step.description}</p>
                  </div>

                  <div class="step-image">
                    <img src={step.image} alt={step.alt} loading="lazy" />
                  </div>
                </section>
              ))}
            </div>
          </section>

          <section class="section" id="offline-account">
            <div class="section-label">Part two</div>
            <h2>Create the offline local profile</h2>

            <p class="section-intro">
              This is the important part. Do not connect the computer to the
              internet before completing these steps.
            </p>

            <div class="warning">
              <strong>This method may change in future Windows versions.</strong>
              <p>
                This documents the method that worked during my own Windows 11
                installation. Microsoft can change the first-time setup process
                through newer installation images and updates.
              </p>
            </div>

            <div class="steps" style="margin-top: 34px;">
              {offlineSteps.map((step) => (
                <section class="step">
                  <div class="step-content">
                    <div class="step-number">Step {step.number}</div>
                    <h3>{step.title}</h3>
                    <p>{step.description}</p>

                    {step.number === "14" && (
                      <div class="command-box">
  <strong>Type this command exactly:</strong>

  <pre class="command"><code>OOBE\BYPASSNRO</code></pre>

  <p class="command-explanation">
    Then press <strong>Enter</strong>. The command contains
    <strong>only the letter O</strong>—there are
    <strong>no zeros (0)</strong> anywhere in the command.
  </p>
</div>
                    )}
                  </div>

                  <div class="step-image">
                    <img src={step.image} alt={step.alt} loading="lazy" />
                  </div>
                </section>
              ))}
            </div>
          </section>

          <section class="section" id="after-installation">
            <div class="section-label">Final checks</div>
            <h2>What to do after reaching the desktop</h2>

            <div class="checklist">
              {afterInstallation.map((item) => (
                <div class="check-card">
